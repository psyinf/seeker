# Godot 4 .gitignore

# Godot-specific ignores
.godot/
/android/

# Imported assets cache (regenerated by the editor)
.import/

# Exported builds / packages
/build/
/export/
*.exe
*.pck
*.zip
*.dmg
*.apk
*.aab

# Mono / C# (only relevant if you add C#)
.mono/
data_*/
*.csproj
*.sln

# Export presets often contain secrets/keystore paths — keep local
export_presets.cfg

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
.vscode/
.idea/
